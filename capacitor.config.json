{
  "appId": "com.ilgazfindik.ilnura",
  "appName": "Ilnura",
  "webDir": "www",
  "backgroundColor": "#0b1430",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0b1430",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0b1430",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b1430"
    }
  }
}
