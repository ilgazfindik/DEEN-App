    "falaq:2": {
      "surah_id": "falaq",
      "ayah_number": 2,
      "source_ayah_key": "falaq:2",
      "source_arabic_text": "مِن شَرِّ مَا خَلَقَ",
      "source_audio_path": "assets/quran/audio/falaq/felak_2.mp3",
      "text": "vor dem Unheil, das von dem ausgehen kann, was Er erschaffen hat,",
      "language": "de",
      "status": "draft_review_required",
      "native_reviewer_approved": false,
      "expert_approved": false,
      "rights_reviewed": false,
      "meaning_reviewed": false,
      "reviewer_note_tr": "Min šarri mā ḫalaq: Negatives aus der Schöpfung, nicht die gesamte Schöpfung als böse definieren; 'kann' als interpretierende Ergänzung prüfen."
    },
    "falaq:3": {
      "surah_id": "falaq",
      "ayah_number": 3,
      "source_ayah_key": "falaq:3",
      "source_arabic_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "source_audio_path": "assets/quran/audio/falaq/felak_3.mp3",
      "text": "und vor dem Übel der Dunkelheit, wenn sie hereinbricht,",
      "language": "de",
      "status": "draft_review_required",
      "native_reviewer_approved": false,
      "expert_approved": false,
      "rights_reviewed": false,
      "meaning_reviewed": false,
      "reviewer_note_tr": "Ghāsiq iḏā waqab: nächtliche Dunkelheit und deren Hereinbrechen; Wortwahl und Kontext prüfen."
    },
    "falaq:4": {
      "surah_id": "falaq",
      "ayah_number": 4,
      "source_ayah_key": "falaq:4",
      "source_arabic_text": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
      "source_audio_path": "assets/quran/audio/falaq/felak_4.mp3",
      "text": "und vor dem Unheil derjenigen, die auf Knoten hauchen,",
      "language": "de",
      "status": "draft_review_required",
      "native_reviewer_approved": false,
      "expert_approved": false,
      "rights_reviewed": false,
      "meaning_reviewed": false,
      "reviewer_note_tr": "An-naffāṯāti fī l-ʿuqad: feminine Pluralform, überlieferter Kontext von Zauberei/Knoten; 'derjenigen' schwächt Geschlechtsreferenz ab; mit Fachgutachten klären."
    },
