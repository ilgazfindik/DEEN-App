    "fatiha:7": {
      "surah_id": "fatiha",
      "ayah_number": 7,
      "source_ayah_key": "fatiha:7",
      "source_arabic_text": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "source_audio_path": "assets/quran/audio/fatiha/fatiha_7.mp3",
      "text": "den Weg derjenigen, denen Du Gutes erwiesen hast, nicht den Weg derer, die Zorn auf sich gezogen haben, und nicht den der Irregehenden.",
